---
// A self-hosted video clip (file in public/media/…). Native controls, no
// autoplay, nothing downloaded until the visitor presses play (preload="none";
// only the optimised poster image loads). Without JS it works the same.
import { getImage } from 'astro:assets';
import { withBase } from '@/lib/url';

interface Props {
  src: string;
  poster: ImageMetadata;
  title: string;
  caption?: string;
  orientation?: 'landscape' | 'portrait';
}

const { src, poster, title, caption, orientation = 'landscape' } = Astro.props;
const posterImg = await getImage({ src: poster, width: Math.min(poster.width, 720), format: 'webp' });
const type = src.endsWith('.webm') ? 'video/webm' : 'video/mp4';
---

<figure class:list={['clip', `clip--${orientation}`]}>
  <video controls preload="none" playsinline poster={posterImg.src} aria-label={title}>
    <source src={withBase(src)} type={type} />
    <a href={withBase(src)}>Download the video: {title}</a>
  </video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .clip {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  video {
    display: block;
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: #000;
    box-shadow: 0 16px 36px -24px rgb(0 0 0 / 0.8);
  }

  .clip--landscape video {
    aspect-ratio: 16 / 9;
  }

  .clip--portrait video {
    aspect-ratio: 9 / 16;
    max-height: 32rem;
    object-fit: contain;
  }

  figcaption {
    font-size: var(--step--1);
    color: var(--text-2);
  }
</style>
