---
// Code-native abstract cover for a project (decorative, no fake screenshots).
// The motif follows the project's first category; the project id seeds small
// variations so no two covers are identical.
interface Props {
  id: string;
  category: string;
  index: number;
  class?: string;
}

const { id, category, index, class: className } = Astro.props;

// Deterministic pseudo-random numbers from the project id.
let seed = [...id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const rand = () => {
  seed = (seed * 1664525 + 1013904223) >>> 0;
  return seed / 2 ** 32;
};

const W = 480;
const H = 300;
const label = String(index).padStart(2, '0');

// Shared background grid
const grid: string[] = [];
for (let x = 0; x <= W; x += 24) grid.push(`M${x} 0V${H}`);
for (let y = 0; y <= H; y += 24) grid.push(`M0 ${y}H${W}`);

// Motif data per category
const waypoints = Array.from({ length: 6 }, (_, i) => ({
  x: 60 + i * 72 + rand() * 18,
  y: 70 + rand() * 160,
}));
const route = waypoints.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');

const traces = Array.from({ length: 7 }, (_, i) => {
  const y = 40 + i * 34;
  const x1 = 30 + rand() * 60;
  const xm = 160 + rand() * 120;
  const dy = (rand() > 0.5 ? 1 : -1) * 24;
  const x2 = 380 + rand() * 70;
  return { d: `M${x1.toFixed(0)} ${y}H${xm.toFixed(0)}l24 ${dy}H${x2.toFixed(0)}`, x1, y, x2, y2: y + dy };
});

const points = Array.from({ length: 46 }, () => {
  const x = 30 + rand() * 420;
  const y = 30 + rand() * 240;
  const boundary = 150 + Math.sin(x / 70) * 50 + (x - 240) * 0.15;
  return { x, y, cls: y < boundary ? 'a' : 'b' };
});
const boundaryPath = Array.from({ length: 25 }, (_, i) => {
  const x = i * 20;
  const y = 150 + Math.sin(x / 70) * 50 + (x - 240) * 0.15;
  return `${i ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
}).join(' ');

const modules = [
  { x: 40, y: 50, w: 110, h: 56 },
  { x: 40, y: 190, w: 110, h: 56 },
  { x: 190, y: 116, w: 110, h: 64 },
  { x: 340, y: 40, w: 104, h: 52 },
  { x: 340, y: 124, w: 104, h: 52 },
  { x: 340, y: 208, w: 104, h: 52 },
];

const pulse = (() => {
  let d = 'M0 170';
  let x = 0;
  while (x < W) {
    const beat = rand() > 0.45;
    if (beat) d += ` H${x + 30} l10 -70 l12 120 l10 -70 H${x + 90}`;
    else d += ` H${x + 60}`;
    x += beat ? 90 : 60;
  }
  return d;
})();
---

<div class:list={['cover', `cover--${category}`, className]} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" focusable="false">
    <path class="grid" d={grid.join('')}></path>

    {
      category === 'robotics' && (
        <g>
          <path class="route" d={route} />
          {waypoints.map((p, i) => (
            <g>
              <rect class={i === 0 || i === waypoints.length - 1 ? 'marker solid' : 'marker'} x={p.x - 9} y={p.y - 9} width="18" height="18" />
              {i % 2 === 0 && <rect class="marker-inner" x={p.x - 4} y={p.y - 4} width="8" height="8" />}
            </g>
          ))}
          <circle class="bot" cx={waypoints[2].x} cy={waypoints[2].y} r="14" />
        </g>
      )
    }

    {
      category === 'embedded' && (
        <g>
          {traces.map((t) => (
            <g>
              <path class="trace" d={t.d} />
              <circle class="pad" cx={t.x1} cy={t.y} r="5" />
              <circle class="pad" cx={t.x2} cy={t.y2} r="5" />
            </g>
          ))}
          <rect class="chip" x="190" y="100" width="100" height="100" rx="6" />
          <path class="pin" d="M200 100v-10M220 100v-10M240 100v-10M260 100v-10M280 100v-10M200 200v10M220 200v10M240 200v10M260 200v10M280 200v10" />
        </g>
      )
    }

    {
      category === 'machine-learning' && (
        <g>
          <path class="boundary" d={boundaryPath} />
          {points.map((p) => (
            <circle class={`pt pt-${p.cls}`} cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="4.2" />
          ))}
        </g>
      )
    }

    {
      category === 'web' && (
        <g>
          <path class="link" d="M150 78 L190 140 M150 218 L190 160 M300 148 L340 66 M300 148 L340 150 M300 148 L340 234" />
          {modules.map((m, i) => (
            <rect class={i === 2 ? 'module core' : 'module'} x={m.x} y={m.y} width={m.w} height={m.h} rx="8" />
          ))}
        </g>
      )
    }

    {
      category === 'health-tech' && (
        <g>
          <path class="pulse" d={pulse} />
        </g>
      )
    }

    <text class="index" x="22" y={H - 22}>{label}</text>
  </svg>
</div>

<style>
  /* Decorative, abstract graphic (dark charcoal with orange accents). Used only
     when a project has no real photo, screenshot or video frame. */
  .cover {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(90% 80% at 80% 15%, rgb(25 170 248 / 0.16), transparent 60%),
      light-dark(#e9e4dc, #1a1a1a);
    color: light-dark(#6f6a62, #7a7a7a);
    aspect-ratio: 16 / 9;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .grid {
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.18;
    fill: none;
  }

  .route,
  .trace,
  .boundary,
  .pulse,
  .link {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .route {
    stroke-dasharray: 6 6;
  }

  .marker {
    fill: light-dark(#f7f4ef, #232323);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .marker.solid,
  .marker-inner {
    fill: currentColor;
  }

  .bot {
    fill: var(--accent);
    stroke: light-dark(#f7f4ef, #1a1a1a);
    stroke-width: 4;
  }

  .trace {
    stroke-width: 1.5;
    opacity: 0.85;
  }

  .pad {
    fill: light-dark(#f7f4ef, #232323);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .chip {
    fill: light-dark(#f7f4ef, #232323);
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .pin {
    stroke: currentColor;
    stroke-width: 2;
  }

  .boundary {
    stroke-dasharray: 2 6;
    stroke: currentColor;
    opacity: 0.7;
  }

  .pt-a {
    fill: var(--accent);
  }

  .pt-b {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .module {
    fill: light-dark(#f7f4ef, #232323);
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .module.core {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .link {
    stroke-width: 1.4;
    stroke: currentColor;
    opacity: 0.7;
  }

  .pulse {
    stroke-width: 2.2;
  }

  .index {
    font-family: var(--font-sans-stack);
    font-weight: 900;
    letter-spacing: -2px;
    font-size: 64px;
    fill: currentColor;
    opacity: 0.55;
  }
</style>
