---
// Image gallery with an accessible lightbox (native <dialog>: Escape closes,
// focus returns to the thumbnail; arrow keys move between images).
// Only rendered when a project actually has images.
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string }[];
  label: string;
  /** Small square thumbnails in a row (e.g. inside a timeline entry). */
  compact?: boolean;
}

const { images, label, compact = false } = Astro.props;
const large = await Promise.all(images.map((img) => getImage({ src: img.src, width: 1800, format: 'webp' })));
---

<div class="gallery" data-gallery>
  <ul class:list={['thumbs', { single: images.length === 1 && !compact, compact }]} aria-label={label}>
    {
      images.map((img, i) => (
        <li>
          <figure>
            <a href={large[i].src} data-gallery-item data-caption={img.caption ?? ''} data-alt={img.alt}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={compact ? [240, 480] : [480, 800, 1200]}
                sizes={compact ? '10rem' : '(max-width: 48rem) 100vw, 50vw'}
                loading="lazy"
              />
              <span class="visually-hidden">Open larger image</span>
            </a>
            {img.caption && !compact && <figcaption>{img.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Image viewer" data-gallery-dialog>
    <div class="lightbox-inner">
      <img alt="" data-gallery-image />
      <p class="lightbox-caption" data-gallery-caption></p>
      <div class="lightbox-controls">
        {
          images.length > 1 && (
            <button type="button" class="btn btn--small" data-gallery-prev>
              <Icon name="arrow-left" /> Previous
            </button>
          )
        }
        <span class="mono muted" data-gallery-count></span>
        {
          images.length > 1 && (
            <button type="button" class="btn btn--small" data-gallery-next>
              Next <Icon name="arrow-right" />
            </button>
          )
        }
        <button type="button" class="btn btn--small close" data-gallery-close>
          <Icon name="close" /> Close
        </button>
      </div>
    </div>
  </dialog>
</div>

<style>
  .thumbs {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-2);
  }

  .thumbs.single {
    grid-template-columns: 1fr;
  }

  .thumbs.compact {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 7.5rem), 1fr));
    gap: 0.6rem;
  }

  .thumbs.compact a {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    box-shadow: 0 10px 24px -16px rgb(0 0 0 / 0.7);
  }

  .thumbs.compact :global(img) {
    height: 100%;
    object-fit: cover;
  }

  .thumbs a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .thumbs :global(img) {
    width: 100%;
    transition: transform 600ms var(--ease);
  }

  .thumbs a:hover :global(img) {
    transform: scale(1.03);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .lightbox {
    width: min(96vw, 1400px);
    max-height: 96vh;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--text);
  }

  .lightbox::backdrop {
    background: rgb(5 12 14 / 0.82);
  }

  .lightbox-inner {
    display: grid;
    gap: 0.75rem;
    padding: var(--s-2);
  }

  .lightbox img {
    max-height: 78vh;
    width: auto;
    margin-inline: auto;
    object-fit: contain;
  }

  .lightbox-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .close {
    margin-left: auto;
  }
</style>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const items = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-item]')];
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
    const image = gallery.querySelector<HTMLImageElement>('[data-gallery-image]');
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-count]');
    if (!dialog || !image || typeof dialog.showModal !== 'function') continue;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + items.length) % items.length;
      const item = items[current];
      image.src = item.href;
      image.alt = item.dataset.alt ?? '';
      if (caption) caption.textContent = item.dataset.caption ?? '';
      if (counter) counter.textContent = `${current + 1} / ${items.length}`;
    };

    items.forEach((item, i) =>
      item.addEventListener('click', (event) => {
        event.preventDefault();
        opener = item;
        show(i);
        dialog.showModal();
      }),
    );
    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
    gallery.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (items.length < 2) return;
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>
