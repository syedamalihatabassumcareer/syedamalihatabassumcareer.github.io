---
// Brand mark: a monogram inside a "sensor ring" — an arc and a node read as a
// field of view, echoing the hero artwork. Pure SVG, inherits currentColor.
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className } = Astro.props;
---

<svg
  class:list={['monogram', className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
>
  <circle class="ring" cx="24" cy="24" r="22.5"></circle>
  <path class="arc" d="M24 1.5a22.5 22.5 0 0 1 19.5 11.25"></path>
  <circle class="node" cx="43.5" cy="12.75" r="2.2"></circle>
  <text class="letters" x="24" y="29.5" text-anchor="middle">SMT</text>
</svg>

<style>
  .monogram {
    flex: none;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.28;
  }
  .arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .node {
    fill: var(--accent);
  }
  .letters {
    fill: currentColor;
    font-family: var(--font-display-stack);
    font-size: 14.5px;
    font-weight: 800;
    letter-spacing: -0.6px;
  }
</style>
