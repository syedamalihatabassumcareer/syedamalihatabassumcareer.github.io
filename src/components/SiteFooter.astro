---
import Icon from './Icon.astro';
import { sections } from '@/data/navigation';
import { profile } from '@/data/profile';
import { withBase } from '@/lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="id">
      <a class="logo" href={withBase('#home')}>
        <span class="logo-mark">Maliha</span><span aria-hidden="true">.</span>
      </a>
      <p class="muted">{profile.name} · {profile.focus}.</p>
    </div>

    <nav aria-label="Footer">
      <ul>
        {
          sections.map((item) => (
            <li>
              <a href={withBase(`#${item.id}`)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="socials" aria-label="Profiles">
      <li>
        <a class="icon-circle" href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" /></a>
      </li>
      {
        profile.links.map((link) => (
          <li>
            <a class="icon-circle" href={link.url} target="_blank" rel="noopener noreferrer me" aria-label={`${link.label} (opens in a new tab)`}>
              <Icon name={link.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap base">
    <p>© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--bg);
    font-size: var(--step--1);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.2fr 2fr auto;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-6);
  }

  .id {
    display: grid;
    gap: var(--s-1);
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 900;
    text-decoration: none;
    width: fit-content;
  }

  .logo-mark {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--s-3);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    color: var(--text-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent-text);
  }

  .socials {
    display: flex;
    gap: var(--s-1);
    padding: 0;
    list-style: none;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-3);
    padding-block: var(--s-2) var(--s-3);
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .footer-inner {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    nav ul {
      justify-content: flex-start;
    }
  }
</style>
