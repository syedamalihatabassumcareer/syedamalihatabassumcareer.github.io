---
// Contact: strong typographic invitation, prominent email action, profiles,
// CV. No form — there is no delivery service configured.
import CopyButton from '@/components/CopyButton.astro';
import Icon from '@/components/Icon.astro';
import { profile } from '@/data/profile';
import { withBase } from '@/lib/url';
---

<section class="section contact brand-band" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="frame" data-reveal>
      <span class="decor" aria-hidden="true">
        <span class="c-ring"></span>
        <span class="c-ring c-ring--2"></span>
        <span class="c-orb"></span>
      </span>
      <p class="c-kicker"><span class="c-num">07</span><span class="c-rule" aria-hidden="true"></span>Contact</p>
      <h2 id="contact-title">Let’s work <span class="accent-grad">together</span>.</h2>
      <p class="lead">
        Recruiting for a Management Trainee programme or a role in AI and technology? Email is the best way to reach me.
        I’m happy to walk you through any role or project on this page.
      </p>
      {
        profile.availability && (
          <p class="availability">
            <span class="dot" aria-hidden="true" />
            {profile.availability.label}
          </p>
        )
      }

      <a class="email" href={`mailto:${profile.email}`}>
        <Icon name="mail" size={22} />
        <span>{profile.email}</span>
      </a>

      <div class="actions">
        <CopyButton label="Copy email" what="Email address" text={profile.email} />
        {
          profile.cv && (
            <a class="btn btn--small" href={withBase(profile.cv.path)} download>
              <Icon name="download" /> Download CV
            </a>
          )
        }
        <ul class="socials" aria-label="Profiles">
          {
            profile.links.map((link) => (
              <li>
                <a class="icon-circle" href={link.url} target="_blank" rel="noopener noreferrer me" aria-label={`${link.label} (opens in a new tab)`}>
                  <Icon name={link.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .frame {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) clamp(1.25rem, 0.5rem + 4vw, 4rem);
    text-align: center;
    overflow: hidden;
  }

  .c-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono-stack);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .c-num {
    font-weight: 700;
    color: var(--text);
  }

  .c-rule {
    width: 3.5rem;
    height: 3px;
    border-radius: 2px;
    background: var(--brand-gradient);
  }

  h2 {
    font-size: clamp(2.75rem, 1.5rem + 5.5vw, 6rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .accent-grad {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    max-width: 52ch;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    margin-top: var(--s-2);
    padding: 0.95rem 1.5rem;
    border-radius: var(--radius-s);
    background: #fff;
    color: #04224d;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.6), 0 0 0 6px rgb(255 255 255 / 0.08);
    font-size: clamp(1rem, 0.85rem + 0.8vw, 1.35rem);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--fast),
      transform var(--fast) var(--ease);
  }

  .email span {
    overflow-wrap: anywhere;
  }

  .email:hover {
    background: #d9f0ff;
    color: #04224d;
  }

  .email:active {
    transform: translateY(1px);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }

  .socials {
    display: flex;
    gap: var(--s-1);
    padding: 0;
    list-style: none;
  }

  /* ── Decorative motion behind the invitation ── */
  .decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .frame {
    isolation: isolate;
  }

  .c-ring {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 46rem;
    aspect-ratio: 1;
    margin-left: -23rem;
    border-radius: 50%;
    border: 1.5px dashed light-dark(rgb(25 170 248 / 0.25), rgb(25 170 248 / 0.22));
  }

  .c-ring--2 {
    top: -25%;
    width: 30rem;
    margin-left: -15rem;
    border-style: solid;
    border-color: light-dark(rgb(26 26 26 / 0.07), rgb(255 255 255 / 0.06));
  }

  .c-ring::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px 3px rgb(25 170 248 / 0.5);
  }

  .c-ring--2::after {
    display: none;
  }

  .c-orb {
    position: absolute;
    right: 9%;
    bottom: 14%;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #bfe9ff, var(--accent) 60%, #0068b4);
    box-shadow: 0 0 30px 6px rgb(25 170 248 / 0.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .c-ring {
      animation: c-spin 40s linear infinite;
    }

    .c-ring--2 {
      animation-duration: 26s;
      animation-direction: reverse;
    }

    @keyframes c-spin {
      to {
        transform: rotate(1turn);
      }
    }

    .c-orb {
      animation: c-float 7s ease-in-out infinite;
    }

    @keyframes c-float {
      50% {
        transform: translate(-14px, -18px);
      }
    }

    .email:hover {
      transform: translateY(-2px);
    }
  }
</style>
