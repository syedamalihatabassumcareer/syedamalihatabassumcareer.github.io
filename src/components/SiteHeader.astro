---
// Floating glass top bar: avatar + name, pill-shaped section links (the
// active one filled orange), theme switch and CV download. A thin line along
// the bottom of the bar shows reading progress.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '@/assets/avatar.png';
import { sections } from '@/data/navigation';
import { profile } from '@/data/profile';
import { getWriting } from '@/lib/content';
import { stripBase, withBase } from '@/lib/url';

const path = stripBase(Astro.url.pathname);
const hasWriting = (await getWriting()).length > 0;
---

<header class="site-header" data-header>
  <div class="wrap shell">
    <div class="bar">
      <span class="smoke" aria-hidden="true"><span class="wisp wisp--1"></span><span class="wisp wisp--2"></span><span class="wisp wisp--3"></span></span>
      <a class="logo" href={withBase('#home')} aria-label={`${profile.name} — home`}>
        <span class="avatar" aria-hidden="true">
          <Image src={avatar} alt="" widths={[48, 96]} sizes="48px" loading="eager" />
        </span>
        <span class="logo-name">{profile.shortName}</span>
      </a>

      <nav id="site-nav" class="site-nav" aria-label="Sections" data-menu>
        <ul>
          {
            sections.map((item, i) => (
              <li class:list={{ secondary: !item.primary }} style={`--i:${i}`}>
                <a href={withBase(`#${item.id}`)} data-nav-link={item.id}>
                  {item.label}
                </a>
              </li>
            ))
          }
          {
            hasWriting && (
              <li class="secondary" style={`--i:${sections.length}`}>
                <a href={withBase('writing/')} aria-current={path === '/writing/' ? 'page' : undefined}>
                  Writing
                </a>
              </li>
            )
          }
        </ul>
      </nav>

      <div class="tools">
        <button class="icon-btn theme-toggle" type="button" data-theme-toggle hidden>
          <Icon name="sun" size={18} class="to-light" />
          <Icon name="moon" size={18} class="to-dark" />
          <span class="visually-hidden" data-theme-label>Switch theme</span>
        </button>
        {
          profile.cv ? (
            <a class="cta" href={withBase(profile.cv.path)} download>
              <Icon name="download" size={16} /> Download CV
            </a>
          ) : (
            <a class="cta" href={withBase('#contact')}>
              Get in touch
            </a>
          )
        }
        <button
          class="icon-btn menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-menu-toggle
          hidden
        >
          <Icon name="menu" size={20} class="when-closed" />
          <Icon name="close" size={20} class="when-open" />
          <span class="visually-hidden">Menu</span>
        </button>
      </div>

      <span class="progress" aria-hidden="true"></span>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 0.6rem;
    pointer-events: none;
  }

  .shell {
    max-width: 78rem;
  }

  /* Haze behind the floating bar: page content scrolling underneath fades
     into smoke instead of meeting a hard edge. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -2.5rem;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 82%, transparent) 0%, color-mix(in srgb, var(--bg) 40%, transparent) 55%, transparent 100%);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent);
    mask-image: linear-gradient(to bottom, #000 45%, transparent);
    opacity: 0;
    transition: opacity 400ms ease;
    pointer-events: none;
  }

  :global(.is-scrolled) .site-header::before {
    opacity: 1;
  }

  .bar {
    --glass: light-dark(rgb(255 255 255 / 0.5), rgb(22 22 22 / 0.42));
    isolation: isolate;
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 3.6rem;
    padding: 0.4rem 0.45rem 0.4rem 0.45rem;
    border: 1px solid light-dark(rgb(0 0 0 / 0.08), rgb(255 255 255 / 0.1));
    border-radius: 999px;
    background:
      linear-gradient(180deg, light-dark(rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.06)), transparent 60%),
      var(--glass);
    backdrop-filter: blur(22px) saturate(1.6);
    -webkit-backdrop-filter: blur(22px) saturate(1.6);
    box-shadow:
      inset 0 1px 0 light-dark(rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.12)),
      inset 0 -1px 0 light-dark(rgb(0 0 0 / 0.04), rgb(0 0 0 / 0.35)),
      0 10px 30px -14px light-dark(rgb(80 40 10 / 0.25), rgb(0 0 0 / 0.7)),
      0 30px 60px -30px light-dark(rgb(80 40 10 / 0.2), rgb(0 0 0 / 0.6));
    pointer-events: auto;
    transition:
      background-color 250ms ease,
      box-shadow 250ms ease;
  }

  :global(.is-scrolled) .bar {
    --glass: light-dark(rgb(255 255 255 / 0.66), rgb(20 20 20 / 0.6));
  }

  /* Smoke: soft blurred wisps drifting slowly inside the glass. */
  .smoke {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .wisp {
    position: absolute;
    top: -60%;
    width: 46%;
    height: 220%;
    border-radius: 50%;
    filter: blur(16px);
    opacity: 0.9;
  }

  .wisp--1 {
    left: -8%;
    background: radial-gradient(closest-side, light-dark(rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.1)), transparent);
  }

  .wisp--2 {
    left: 32%;
    background: radial-gradient(closest-side, light-dark(rgb(25 170 248 / 0.14), rgb(25 170 248 / 0.16)), transparent);
  }

  .wisp--3 {
    left: 66%;
    background: radial-gradient(closest-side, light-dark(rgb(210 200 190 / 0.6), rgb(200 200 200 / 0.09)), transparent);
  }

  /* A soft shadow pooled under the bar, so it reads as floating. */
  .bar::after {
    content: '';
    position: absolute;
    z-index: -2;
    left: 10%;
    right: 10%;
    bottom: -20px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(closest-side, light-dark(rgb(90 50 20 / 0.22), rgb(0 0 0 / 0.55)), transparent);
    filter: blur(6px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wisp--1 {
      animation: drift-a 18s ease-in-out infinite alternate;
    }

    .wisp--2 {
      animation: drift-b 22s ease-in-out infinite alternate;
    }

    .wisp--3 {
      animation: drift-a 26s ease-in-out infinite alternate-reverse;
    }

    @keyframes drift-a {
      from { transform: translateX(-12%) scale(1); }
      to { transform: translateX(55%) scale(1.25); }
    }

    @keyframes drift-b {
      from { transform: translateX(40%) scale(1.15); opacity: 0.6; }
      to { transform: translateX(-50%) scale(0.9); opacity: 1; }
    }

    /* The bar settles in from above on load, then floats very slightly. */
    .bar {
      animation:
        bar-in 700ms var(--ease) both,
        bar-float 9s ease-in-out 700ms infinite;
    }

    @keyframes bar-in {
      from { opacity: 0; transform: translateY(-14px) scale(0.98); }
    }

    @keyframes bar-float {
      50% { translate: 0 2px; }
    }
  }

  /* Reading progress (set by script as --progress, 0…1). */
  .progress {
    position: absolute;
    left: 1.75rem;
    right: 1.75rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-gradient);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    pointer-events: none;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    margin-right: auto;
    padding-right: 0.5rem;
    font-size: 1.05rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .avatar {
    position: relative;
    display: block;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    padding: 2px;
    background: var(--accent-gradient);
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: radial-gradient(circle at 50% 35%, #bfe9ff, #19aaf8 70%);
    border: 2px solid light-dark(#fff, #161616);
  }

  .site-nav ul {
    display: flex;
    gap: 0.15rem;
    padding: 0;
    list-style: none;
  }

  .site-nav li.secondary {
    display: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.95rem;
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--text);
    background: light-dark(rgb(0 0 0 / 0.05), rgb(255 255 255 / 0.07));
  }

  .site-nav a[aria-current] {
    color: var(--on-accent);
    background: var(--accent);
    box-shadow: 0 6px 18px -8px rgb(25 170 248 / 0.8);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.14));
    border-radius: 50%;
    background: light-dark(rgb(255 255 255 / 0.5), rgb(255 255 255 / 0.04));
    color: var(--text);
    transition:
      border-color var(--fast),
      color var(--fast),
      transform 300ms var(--ease);
  }

  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .theme-toggle:hover {
    transform: rotate(-20deg);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding-inline: 1.15rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 10px 24px -12px rgb(25 170 248 / 0.9);
    transition:
      transform 250ms var(--ease),
      box-shadow 250ms var(--ease);
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px -12px rgb(25 170 248 / 1);
  }

  :global([data-effective-theme='dark']) .theme-toggle :global(.to-dark),
  :global([data-effective-theme='light']) .theme-toggle :global(.to-light) {
    display: none;
  }

  .menu-toggle :global(.when-open),
  .menu-toggle[aria-expanded='true'] :global(.when-closed) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.when-open) {
    display: block;
  }

  /* Medium desktop: avatar only, to leave room for the links. */
  @media (min-width: 64rem) and (max-width: 79.99rem) {
    .logo-name {
      display: none;
    }

    .site-nav a {
      padding-inline: 0.7rem;
    }
  }

  /* ── Compact screens ──────────────────────────────────────────────── */
  @media (max-width: 63.99rem) {
    .bar {
      flex-wrap: wrap;
      gap: 0.25rem var(--s-1);
      border-radius: 1.75rem;
    }

    /* Without JS the links wrap below the bar. */
    .site-nav {
      order: 3;
      width: 100%;
    }

    .site-nav ul {
      flex-wrap: wrap;
    }

    .site-nav li.secondary {
      display: list-item;
    }

    .cta {
      display: none;
    }

    /* With JS: a rounded glass panel under the bar. */
    :global(.js) .bar {
      flex-wrap: nowrap;
      border-radius: 999px;
    }

    :global(.js) .site-nav {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      width: auto;
      padding: var(--s-1);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: var(--shadow);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
      transform-origin: top center;
      transition:
        opacity 200ms ease,
        transform 220ms var(--ease),
        visibility 0s linear 220ms;
    }

    :global(.js) .site-nav[data-open] {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 200ms ease,
        transform 220ms var(--ease);
    }

    :global(.js) .site-nav ul {
      flex-direction: column;
      gap: 0.15rem;
    }

    :global(.js) .site-nav a {
      width: 100%;
      min-height: 3rem;
      padding-inline: 1rem;
      font-size: var(--step-0);
    }
  }

  @media (max-width: 23rem) {
    .logo-name {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .menu-toggle {
      display: none !important;
    }
  }

  /* Menu items cascade in when the panel opens. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 63.99rem) {
    :global(.js) .site-nav[data-open] li {
      animation: menu-in 320ms var(--ease) both;
      animation-delay: calc(var(--i, 0) * 35ms);
    }

    @keyframes menu-in {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }
    }
  }
</style>
