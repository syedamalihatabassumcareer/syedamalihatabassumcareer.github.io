---
// Animated, code-drawn scene for an expertise card (decorative). One scene
// per skill area; animations pause off-screen (site.ts toggles .is-playing)
// and are disabled entirely for prefers-reduced-motion.
interface Props {
  kind: string;
}
const { kind } = Astro.props;

// Neural network layout (machine learning)
const layers = [
  { x: 48, n: 3 },
  { x: 122, n: 5 },
  { x: 196, n: 4 },
  { x: 268, n: 2 },
];
const nodes = layers.map((l, li) =>
  Array.from({ length: l.n }, (_, i) => ({ x: l.x, y: 110 + (i - (l.n - 1) / 2) * 34, li })),
);
const edges = nodes.slice(0, -1).flatMap((layer, li) =>
  layer.flatMap((a) => nodes[li + 1].map((b) => ({ a, b, li }))),
);

// Code typed in the terminal (programming)
const code = [
  { t: 'def evaluate(model, loader):', c: 'kw' },
  { t: '    probs = model.predict(loader)', c: '' },
  { t: '    ece = calibration_error(probs)', c: '' },
  { t: '    return {"ece": ece}', c: 'str' },
];
---

<div class:list={['viz', `viz--${kind}`]} aria-hidden="true" data-anim>
  <div class="grid-bg"></div>

  {
    kind === 'machine-learning' && (
      <svg viewBox="0 0 320 220" class="scene">
        {edges.map((e) => (
          <line class="edge" x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} />
        ))}
        {edges.map((e, i) => (
          <line
            class="pulse"
            x1={e.a.x}
            y1={e.a.y}
            x2={e.b.x}
            y2={e.b.y}
            pathLength="100"
            style={`animation-delay:${e.li * 0.55 + (i % 5) * 0.08}s`}
          />
        ))}
        {nodes.flat().map((n, i) => (
          <circle class="node" cx={n.x} cy={n.y} r="7" style={`animation-delay:${n.li * 0.55 + 0.2 + (i % 3) * 0.05}s`} />
        ))}
      </svg>
    )
  }

  {
    kind === 'computer-vision' && (
      <div class="cv">
        <div class="cube-stage">
          <div class="cube">
            <span class="face f1" />
            <span class="face f2" />
            <span class="face f3" />
            <span class="face f4" />
            <span class="face f5" />
            <span class="face f6" />
          </div>
        </div>
        <span class="bbox">
          <span class="bbox-label">3D box</span>
        </span>
        <span class="scan" />
        <span class="corner c1" />
        <span class="corner c2" />
        <span class="corner c3" />
        <span class="corner c4" />
      </div>
    )
  }

  {
    kind === 'agentic-systems' && (
      <div class="agent">
        <div class="orbits">
          <div class="orbit o1">
            <span class="sat" />
          </div>
          <div class="orbit o2">
            <span class="sat" />
          </div>
          <div class="orbit o3">
            <span class="sat" />
          </div>
        </div>
        <span class="core">
          <span class="core-ring" />
        </span>
      </div>
    )
  }

  {
    kind === 'embedded-robotics' && (
      <svg viewBox="0 0 320 220" class="scene">
        <g class="chip-group">
          <rect class="chip" x="214" y="70" width="72" height="72" rx="8" />
          {[0, 1, 2, 3, 4].map((i) => (
            <>
              <line class="pin" x1={224 + i * 13} y1="62" x2={224 + i * 13} y2="70" />
              <line class="pin" x1={224 + i * 13} y1="142" x2={224 + i * 13} y2="150" />
            </>
          ))}
          <circle class="led l1" cx="236" cy="96" r="4" />
          <circle class="led l2" cx="250" cy="96" r="4" />
          <circle class="led l3" cx="264" cy="96" r="4" />
          <rect class="core-chip" x="232" y="110" width="36" height="20" rx="3" />
        </g>
        <path class="wire" d="M214 106 C 190 106, 170 170, 120 186" />
        <rect class="base" x="62" y="180" width="76" height="14" rx="4" />
        <g class="arm1">
          <rect class="link" x="94" y="104" width="12" height="80" rx="6" />
          <circle class="joint" cx="100" cy="184" r="9" />
          <g class="arm2">
            <rect class="link" x="94" y="48" width="12" height="62" rx="6" />
            <circle class="joint" cx="100" cy="108" r="8" />
            <path class="grip" d="M88 52 L94 36 M112 52 L106 36" />
            <circle class="joint small" cx="100" cy="50" r="5" />
          </g>
        </g>
      </svg>
    )
  }

  {
    kind === 'programming' && (
      <div class="term">
        <div class="term-bar">
          <span />
          <span />
          <span />
          <em>eval.py</em>
        </div>
        <div class="term-body">
          {code.map((line, i) => (
            <p class:list={['line', line.c]} style={`--n:${line.t.length}; --i:${i}`}>
              <span>{line.t}</span>
            </p>
          ))}
          <p class="line prompt" style="--i:4">
            <span>&gt;&gt;&gt; </span>
            <b class="cursor" />
          </p>
        </div>
      </div>
    )
  }

  {
    kind === 'tools' && (
      <svg viewBox="0 0 320 220" class="scene">
        <path class="branch main" d="M30 120 H290" />
        <path class="branch feat" d="M90 120 C 110 120, 110 70, 140 70 H210 C 240 70, 240 120, 260 120" />
        {[
          [30, 120],
          [90, 120],
          [140, 70],
          [175, 70],
          [210, 70],
          [160, 120],
          [260, 120],
          [290, 120],
        ].map(([x, y], i) => (
          <circle class="commit" cx={x} cy={y} r="7" style={`animation-delay:${i * 0.35}s`} />
        ))}
        <g transform="translate(70 178)">
          <g class="gear">
            <circle r="16" />
            {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
              <rect x="-4" y="-24" width="8" height="10" rx="2" transform={`rotate(${a})`} />
            ))}
            <circle class="hole" r="6" />
          </g>
        </g>
        <g transform="translate(104 196)">
          <g class="gear gear--small">
            <circle r="9" />
            {[0, 60, 120, 180, 240, 300].map((a) => (
              <rect x="-3" y="-15" width="6" height="7" rx="1.5" transform={`rotate(${a})`} />
            ))}
            <circle class="hole" r="3.5" />
          </g>
        </g>
      </svg>
    )
  }
</div>

<style>
  .viz {
    --line: rgb(255 255 255 / 0.22);
    --glow: rgb(25 170 248 / 0.55);
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 11;
    border-radius: 12px;
    background:
      radial-gradient(90% 70% at 70% 20%, rgb(25 170 248 / 0.22), transparent 65%),
      radial-gradient(60% 60% at 15% 90%, rgb(25 170 248 / 0.1), transparent 70%),
      #141414;
    color: #f5f5f5;
    isolation: isolate;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(80% 80% at 50% 50%, #000, transparent);
  }

  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Machine learning: neural network ── */
  .edge {
    stroke: var(--line);
    stroke-width: 1;
  }

  .pulse {
    stroke: #19aaf8;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 10 100;
    stroke-dashoffset: 110;
    opacity: 0;
  }

  .node {
    fill: #1e1e1e;
    stroke: #19aaf8;
    stroke-width: 2;
  }

  /* ── Computer vision: 3D cube in a viewfinder ── */
  .cv {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .cube-stage {
    perspective: 520px;
  }

  .cube {
    --s: 76px;
    position: relative;
    width: var(--s);
    height: var(--s);
    transform-style: preserve-3d;
    transform: rotateX(-24deg) rotateY(35deg);
  }

  .face {
    position: absolute;
    inset: 0;
    border: 1.5px solid rgb(25 170 248 / 0.9);
    background: rgb(25 170 248 / 0.08);
    box-shadow: inset 0 0 18px rgb(25 170 248 / 0.18);
  }

  .f1 {
    transform: translateZ(calc(var(--s) / 2));
  }
  .f2 {
    transform: rotateY(180deg) translateZ(calc(var(--s) / 2));
  }
  .f3 {
    transform: rotateY(90deg) translateZ(calc(var(--s) / 2));
    border-color: rgb(255 255 255 / 0.55);
  }
  .f4 {
    transform: rotateY(-90deg) translateZ(calc(var(--s) / 2));
    border-color: rgb(255 255 255 / 0.55);
  }
  .f5 {
    transform: rotateX(90deg) translateZ(calc(var(--s) / 2));
  }
  .f6 {
    transform: rotateX(-90deg) translateZ(calc(var(--s) / 2));
  }

  .bbox {
    position: absolute;
    width: 46%;
    height: 66%;
    border: 1.5px dashed rgb(255 255 255 / 0.7);
    border-radius: 6px;
  }

  .bbox-label {
    position: absolute;
    top: -0.65rem;
    left: 0.4rem;
    padding: 0 0.35rem;
    border-radius: 3px;
    background: #19aaf8;
    color: #111;
    font: 700 0.62rem/1.4 var(--font-mono-stack);
  }

  .scan {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 12%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #19aaf8, transparent);
    box-shadow: 0 0 12px var(--glow);
  }

  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: rgb(255 255 255 / 0.75);
    border-style: solid;
  }

  .c1 {
    top: 8%;
    left: 5%;
    border-width: 2px 0 0 2px;
  }
  .c2 {
    top: 8%;
    right: 5%;
    border-width: 2px 2px 0 0;
  }
  .c3 {
    bottom: 8%;
    left: 5%;
    border-width: 0 0 2px 2px;
  }
  .c4 {
    bottom: 8%;
    right: 5%;
    border-width: 0 2px 2px 0;
  }

  /* ── Agentic systems: agent with orbiting tools ── */
  .agent {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 600px;
  }

  .orbits {
    position: absolute;
    width: 62%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(64deg) rotateZ(-18deg);
  }

  .orbit {
    position: absolute;
    inset: 0;
    border: 1px dashed rgb(255 255 255 / 0.32);
    border-radius: 50%;
  }

  .o2 {
    inset: 14%;
    transform: rotateZ(40deg);
  }

  .o3 {
    inset: 28%;
    transform: rotateZ(-30deg);
  }

  .sat {
    position: absolute;
    top: -7px;
    left: calc(50% - 7px);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #19aaf8;
    box-shadow: 0 0 14px var(--glow);
  }

  .o2 .sat {
    background: #f5f5f5;
    box-shadow: 0 0 10px rgb(255 255 255 / 0.5);
  }

  .core {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #bfe9ff, #19aaf8 55%, #0068b4);
    box-shadow: 0 0 30px 6px var(--glow);
  }

  .core-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1.5px solid rgb(25 170 248 / 0.6);
  }

  /* ── Robotics & embedded: robot arm + chip ── */
  .base,
  .link {
    fill: #2a2a2a;
    stroke: rgb(255 255 255 / 0.55);
    stroke-width: 1.2;
  }

  .joint {
    fill: #19aaf8;
    stroke: #141414;
    stroke-width: 2;
  }

  .grip {
    stroke: #f5f5f5;
    stroke-width: 3;
    stroke-linecap: round;
    fill: none;
  }

  .arm1 {
    transform-box: view-box;
    transform-origin: 100px 184px;
    transform: rotate(-14deg);
  }

  .arm2 {
    transform-box: view-box;
    transform-origin: 100px 108px;
    transform: rotate(28deg);
  }

  .chip {
    fill: #1e1e1e;
    stroke: rgb(255 255 255 / 0.5);
    stroke-width: 1.2;
  }

  .core-chip {
    fill: rgb(25 170 248 / 0.15);
    stroke: #19aaf8;
  }

  .pin {
    stroke: rgb(255 255 255 / 0.5);
    stroke-width: 2;
  }

  .led {
    fill: #19aaf8;
  }

  .wire {
    fill: none;
    stroke: #19aaf8;
    stroke-width: 1.6;
    stroke-dasharray: 4 6;
  }

  /* ── Programming: typing terminal ── */
  .term {
    position: absolute;
    inset: 9% 7%;
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    background: #0d0d0d;
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: 0 18px 40px -20px #000;
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 10px;
    background: #1b1b1b;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .term-bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #19aaf8;
  }

  .term-bar span:nth-child(2) {
    background: #9be7b4;
  }

  .term-bar span:nth-child(3) {
    background: #5fd38d;
  }

  .term-bar em {
    margin-left: 6px;
    font: 500 0.62rem var(--font-mono-stack);
    font-style: normal;
    color: #8f8f8f;
  }

  .term-body {
    padding: 10px 12px;
    font: 500 clamp(0.55rem, 0.4rem + 0.35vw, 0.72rem) / 1.75 var(--font-mono-stack);
    color: #d6d6d6;
  }

  .line {
    white-space: pre;
    overflow: hidden;
  }

  .line span {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .line.kw span {
    color: #19aaf8;
  }

  .line.str span {
    color: #9be7b4;
  }

  .prompt span {
    color: #5fd38d;
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    vertical-align: -0.15em;
    background: #19aaf8;
  }

  /* ── Tools: git graph + gears ── */
  .branch {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .main {
    stroke: rgb(255 255 255 / 0.45);
  }

  .feat {
    stroke: #19aaf8;
  }

  .commit {
    fill: #141414;
    stroke: #f5f5f5;
    stroke-width: 2.5;
    transform-box: fill-box;
    transform-origin: center;
  }

  .gear {
    fill: rgb(255 255 255 / 0.18);
    transform-box: fill-box;
    transform-origin: center;
  }

  .gear circle:first-child {
    fill: rgb(255 255 255 / 0.22);
  }

  .gear .hole {
    fill: #141414;
  }

  .gear--small {
    fill: rgb(25 170 248 / 0.6);
  }

  /* ── Motion ── */
  @media (prefers-reduced-motion: no-preference) {
    .pulse {
      animation: pulse 2.6s linear infinite;
    }

    @keyframes pulse {
      0% {
        stroke-dashoffset: 110;
        opacity: 1;
      }
      45% {
        stroke-dashoffset: 0;
        opacity: 1;
      }
      46%,
      100% {
        opacity: 0;
      }
    }

    .node {
      animation: node 2.6s ease-in-out infinite;
    }

    @keyframes node {
      0%,
      100% {
        fill: #1e1e1e;
      }
      20% {
        fill: #19aaf8;
      }
    }

    .cube {
      animation: spin 9s linear infinite;
    }

    @keyframes spin {
      from {
        transform: rotateX(-24deg) rotateY(0deg);
      }
      to {
        transform: rotateX(-24deg) rotateY(360deg);
      }
    }

    .scan {
      animation: scan 3.2s ease-in-out infinite alternate;
    }

    @keyframes scan {
      to {
        top: 86%;
      }
    }

    .bbox {
      animation: track 4.5s ease-in-out infinite;
    }

    @keyframes track {
      50% {
        transform: scale(1.06) translateX(3%);
      }
    }

    .orbit {
      animation: orbit 7s linear infinite;
    }

    .o2 {
      animation-duration: 5s;
      animation-direction: reverse;
    }

    .o3 {
      animation-duration: 3.6s;
    }

    @keyframes orbit {
      from {
        rotate: 0deg;
      }
      to {
        rotate: 360deg;
      }
    }

    .core-ring {
      animation: ring 2.4s ease-out infinite;
    }

    @keyframes ring {
      from {
        transform: scale(0.8);
        opacity: 1;
      }
      to {
        transform: scale(1.8);
        opacity: 0;
      }
    }

    .arm1 {
      animation: arm1 4s ease-in-out infinite alternate;
    }

    @keyframes arm1 {
      from {
        transform: rotate(-22deg);
      }
      to {
        transform: rotate(16deg);
      }
    }

    .arm2 {
      animation: arm2 3s ease-in-out infinite alternate;
    }

    @keyframes arm2 {
      from {
        transform: rotate(42deg);
      }
      to {
        transform: rotate(-30deg);
      }
    }

    .led {
      animation: blink 1.2s steps(2, jump-none) infinite;
    }

    .l2 {
      animation-delay: 0.4s;
    }

    .l3 {
      animation-delay: 0.8s;
    }

    @keyframes blink {
      50% {
        opacity: 0.2;
      }
    }

    .wire {
      animation: flow 1.6s linear infinite;
    }

    @keyframes flow {
      to {
        stroke-dashoffset: -20;
      }
    }

    /* Typing: each line reveals character by character, then the loop restarts. */
    .line span {
      width: 0;
      animation: type 9s steps(var(--n), end) infinite;
      animation-delay: calc(var(--i) * 1.1s);
    }

    .prompt span {
      width: auto;
      animation: none;
    }

    @keyframes type {
      0% {
        width: 0;
      }
      12%,
      85% {
        width: calc(var(--n) * 1ch);
      }
      100% {
        width: calc(var(--n) * 1ch);
      }
    }

    .cursor {
      animation: cursor 1s steps(2, jump-none) infinite;
    }

    @keyframes cursor {
      50% {
        opacity: 0;
      }
    }

    .commit {
      animation: commit 4.2s var(--ease) infinite;
    }

    @keyframes commit {
      0%,
      8% {
        transform: scale(0.4);
        stroke: #f5f5f5;
      }
      18% {
        transform: scale(1.3);
        stroke: #19aaf8;
      }
      30%,
      100% {
        transform: scale(1);
        stroke: #f5f5f5;
      }
    }

    .gear {
      animation: gear 6s linear infinite;
    }

    .gear--small {
      animation-duration: 3.6s;
      animation-direction: reverse;
    }

    @keyframes gear {
      to {
        rotate: 360deg;
      }
    }

    /* Pause scenes that are off-screen (site.ts adds .is-playing when visible). */
    :global(.js) .viz:not(.is-playing) *,
    :global(.js) .viz:not(.is-playing) *::after,
    :global(.js) .viz:not(.is-playing) *::before {
      animation-play-state: paused;
    }
  }

  /* Static (reduced-motion / no-animation) state: show every line typed. */
  @media (prefers-reduced-motion: reduce) {
    .line span {
      width: auto;
    }
  }
</style>
