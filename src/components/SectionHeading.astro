---
// Editorial section heading: "01 —— Kicker", a large left-aligned title with
// the subtitle beside it on wide screens.
interface Props {
  id: string;
  title: string;
  /** Short line beside / under the title. */
  sub?: string;
  /** Small label above the title, e.g. "Track record". */
  kicker?: string;
  /** Section number, e.g. "03". */
  num?: string;
  /** Part of `title` to show in the brand gradient. */
  highlight?: string;
}
const { id, title, sub, kicker, num, highlight } = Astro.props;
const at = highlight ? title.indexOf(highlight) : -1;
const parts = at >= 0 ? [title.slice(0, at), highlight!, title.slice(at + highlight!.length)] : [title, '', ''];
---

<header class="section-heading" data-reveal>
  {
    (num || kicker) && (
      <p class="sh-kicker">
        {num && <span class="sh-num">{num}</span>}
        <span class="rule" aria-hidden="true" />
        {kicker}
      </p>
    )
  }
  <h2 id={id}>
    {parts[0]}{parts[1] && <span class="sh-hl">{parts[1]}</span>}{parts[2]}<span class="dot-end" aria-hidden="true">.</span>
  </h2>
  {sub && <p class="sh-sub">{sub}</p>}
  <slot />
</header>
