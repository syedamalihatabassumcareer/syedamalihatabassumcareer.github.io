---
// Centred section heading with a grey subtitle (reference style).
interface Props {
  id: string;
  title: string;
  /** Short line under the title. */
  sub?: string;
  /** Small label above the title, e.g. "02 · Research". */
  kicker?: string;
}
const { id, title, sub, kicker } = Astro.props;
---

<header class="section-heading" data-reveal>
  {kicker && <p class="eyebrow eyebrow--accent">{kicker}</p>}
  <h2 id={id}>{title}</h2>
  <span class="rule" aria-hidden="true"></span>
  {sub && <p>{sub}</p>}
  <slot />
</header>
