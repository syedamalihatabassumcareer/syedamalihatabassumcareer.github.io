---
// Decorative, code-drawn 3D cover for the game project until a real screenshot
// is supplied (owner's request). It shows the game's idea, not its graphics:
// a tilted arena floor, the glowing rift at its centre, turrets, and enemies
// (green/orange/red, as in the report) marching in from the corners.
// CSS 3D transforms only; motion is off for reduced-motion users.

// Enemy lanes: start offsets (px) on the 600×600 floor, measured from the rift.
const lanes = [
  { x: -250, y: -230 },
  { x: 250, y: -220 },
  { x: -260, y: 210 },
  { x: 240, y: 240 },
];
const kinds = ['easy', 'medium', 'hard'] as const;
const enemies = Array.from({ length: 12 }, (_, i) => ({
  ...lanes[i % lanes.length],
  kind: kinds[i % 3],
  delay: -((i * 1.37) % 6).toFixed(2),
}));
const turrets = [
  { x: 30, y: 34, a: 0 },
  { x: 68, y: 30, a: 40 },
  { x: 33, y: 68, a: 120 },
  { x: 70, y: 66, a: 200 },
];
const sparks = Array.from({ length: 6 }, (_, i) => ({ dx: Math.round(Math.cos(i) * 14), d: -(i * 0.45).toFixed(2) }));
---

<div class="game" aria-hidden="true">
  <div class="sky"></div>
  <div class="scene">
    <div class="floor">
      <span class="lane lane--a"></span>
      <span class="lane lane--b"></span>
      <div class="rift">
        <span class="ring ring--1"></span>
        <span class="ring ring--2"></span>
        <span class="ring ring--3"></span>
        <span class="core"></span>
        {sparks.map((s) => <span class="spark" style={`--dx:${s.dx}px;--d:${s.d}s`} />)}
      </div>
      {
        turrets.map((t) => (
          <span class="turret" style={`left:${t.x}%;top:${t.y}%;--a:${t.a}deg`}>
            <span class="cube">
              <i class="f f--top" />
              <i class="f f--front" />
              <i class="f f--back" />
              <i class="f f--left" />
              <i class="f f--right" />
            </span>
          </span>
        ))
      }
      {
        enemies.map((e) => (
          <span class:list={['enemy', `enemy--${e.kind}`]} style={`--x:${e.x}px;--y:${e.y}px;--d:${e.delay}s`}>
            <span class="body" />
          </span>
        ))
      }
      <span class="enemy enemy--boss" style="--x:0px;--y:-280px;--d:-2s">
        <span class="body"></span>
      </span>
    </div>
  </div>
  <span class="hud hud--l">WAVE 07</span>
  <span class="hud hud--r">CORE ▮▮▮▮▮▮▮▯▯▯</span>
</div>

<style>
  .game {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 50% 62%, rgb(25 170 248 / 0.32), transparent 70%),
      radial-gradient(120% 90% at 50% 0%, #1d1238, #07060d 70%);
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 12% 18%, #fff8 50%, transparent),
      radial-gradient(1px 1px at 32% 8%, #fff6 50%, transparent),
      radial-gradient(1.5px 1.5px at 58% 14%, #fff9 50%, transparent),
      radial-gradient(1px 1px at 76% 22%, #fff6 50%, transparent),
      radial-gradient(1px 1px at 90% 10%, #fff8 50%, transparent),
      radial-gradient(1px 1px at 44% 26%, #fff5 50%, transparent);
  }

  .scene {
    position: absolute;
    inset: 0;
    perspective: 760px;
    perspective-origin: 50% 20%;
  }

  .floor {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 600px;
    height: 600px;
    margin: -300px 0 0 -300px;
    transform-style: preserve-3d;
    transform: rotateX(64deg) rotateZ(var(--spin, 0deg));
    background:
      radial-gradient(circle at 50% 50%, rgb(25 170 248 / 0.28), transparent 45%),
      repeating-linear-gradient(0deg, rgb(95 196 250 / 0.16) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(90deg, rgb(95 196 250 / 0.16) 0 1px, transparent 1px 40px);
    border-radius: 24px;
    box-shadow: 0 0 0 1px rgb(25 170 248 / 0.25);
  }

  /* Paths the enemies follow */
  .lane {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 760px;
    height: 10px;
    margin: -5px 0 0 -380px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.08) 20%, rgb(255 255 255 / 0.08) 80%, transparent);
    border-radius: 5px;
  }

  .lane--a {
    transform: rotate(43deg);
  }

  .lane--b {
    transform: rotate(-43deg);
  }

  /* The rift at the centre */
  .rift {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-style: preserve-3d;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 2px dashed rgb(25 170 248 / 0.75);
    translate: -50% -50%;
  }

  .ring--1 {
    width: 110px;
    height: 110px;
  }

  .ring--2 {
    width: 170px;
    height: 170px;
    border-style: solid;
    border-color: rgb(255 180 120 / 0.35);
  }

  .ring--3 {
    width: 240px;
    height: 240px;
    border-color: rgb(229 50 45 / 0.4);
    border-width: 1px;
  }

  .core {
    position: absolute;
    width: 54px;
    height: 54px;
    margin: -27px 0 0 -27px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 35%, #fff 0 8%, #ffc48a 22%, #19aaf8 55%, #8a1c00 100%);
    box-shadow: 0 0 26px 8px rgb(25 170 248 / 0.6);
    transform: translateZ(40px) rotateX(-64deg);
  }

  .spark {
    position: absolute;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: #ffd2a8;
    box-shadow: 0 0 6px 2px rgb(25 170 248 / 0.8);
    transform: translate3d(var(--dx), 0, 40px);
    opacity: 0;
  }

  /* Turrets: small cubes standing on the floor */
  .turret {
    position: absolute;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    transform-style: preserve-3d;
  }

  .cube {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateZ(var(--a));
  }

  .f {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 200 150 / 0.8);
    background: linear-gradient(160deg, rgb(70 60 90 / 0.95), rgb(30 24 44 / 0.95));
  }

  .f--top {
    transform: translateZ(26px);
    background: linear-gradient(160deg, #5c4a7a, #2c2340);
    box-shadow: inset 0 0 0 5px rgb(25 170 248 / 0.55);
  }

  .f--front {
    transform-origin: 50% 100%;
    transform: rotateX(-90deg);
  }

  .f--back {
    transform-origin: 50% 0;
    transform: rotateX(90deg);
  }

  .f--left {
    transform-origin: 0 50%;
    transform: rotateY(-90deg);
  }

  .f--right {
    transform-origin: 100% 50%;
    transform: rotateY(90deg);
  }

  /* Enemies: start partway along their lane (static frame) */
  .enemy {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-style: preserve-3d;
    transform: translate(calc(var(--x) * 0.55), calc(var(--y) * 0.55));
  }

  .body {
    position: absolute;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff 0 10%, var(--c) 45%, color-mix(in srgb, var(--c) 40%, #000) 100%);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--c) 70%, transparent);
    transform: translateZ(9px) rotateX(-64deg);
  }

  .enemy--easy {
    --c: #4ade80;
  }

  .enemy--medium {
    --c: #fb923c;
  }

  .enemy--hard {
    --c: #ef4444;
  }

  .enemy--boss {
    --c: #c026d3;
  }

  .enemy--boss .body {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    transform: translateZ(18px) rotateX(-64deg);
    box-shadow:
      0 0 0 2px rgb(255 255 255 / 0.5),
      0 0 22px 4px color-mix(in srgb, var(--c) 70%, transparent);
  }

  .hud {
    position: absolute;
    top: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(0 0 0 / 0.35);
    color: #ffd8b8;
    font-family: var(--font-mono-stack);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .hud--l {
    left: 0.75rem;
  }

  .hud--r {
    right: 0.75rem;
    color: #ffb27a;
  }

  @media (prefers-reduced-motion: no-preference) {
    .floor {
      animation: gc-sway 14s ease-in-out infinite alternate;
    }

    @keyframes gc-sway {
      from {
        transform: rotateX(64deg) rotateZ(-8deg);
      }

      to {
        transform: rotateX(62deg) rotateZ(8deg);
      }
    }

    .ring--1 {
      animation: gc-spin 9s linear infinite;
    }

    .ring--2 {
      animation: gc-spin 16s linear infinite reverse;
    }

    .ring--3 {
      animation: gc-spin 24s linear infinite;
    }

    @keyframes gc-spin {
      to {
        transform: rotate(1turn);
      }
    }

    .core {
      animation: gc-pulse 2.4s ease-in-out infinite;
    }

    @keyframes gc-pulse {
      50% {
        scale: 1.14;
      }
    }

    .spark {
      animation: gc-rise 2.7s ease-out infinite;
      animation-delay: var(--d);
    }

    @keyframes gc-rise {
      0% {
        opacity: 0;
        transform: translate3d(var(--dx), 0, 40px);
      }

      20% {
        opacity: 1;
      }

      100% {
        opacity: 0;
        transform: translate3d(calc(var(--dx) * 2.5), 0, 140px);
      }
    }

    .cube {
      animation: gc-aim 6s ease-in-out infinite alternate;
    }

    @keyframes gc-aim {
      to {
        transform: rotateZ(calc(var(--a) + 120deg));
      }
    }

    .enemy {
      animation: gc-march 6s linear infinite;
      animation-delay: var(--d);
    }

    .enemy--boss {
      animation-duration: 12s;
    }

    @keyframes gc-march {
      0% {
        opacity: 0;
        transform: translate(var(--x), var(--y));
      }

      10% {
        opacity: 1;
      }

      85% {
        opacity: 1;
      }

      100% {
        opacity: 0;
        transform: translate(calc(var(--x) * 0.12), calc(var(--y) * 0.12));
      }
    }
  }
</style>
