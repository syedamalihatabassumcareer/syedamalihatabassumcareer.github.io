---
// Writing section. Generates /writing/ and /writing/<post>/ ONLY when at least
// one non-draft Markdown file exists in src/content/writing/ — otherwise no
// pages are built and the nav link stays hidden.
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { getWriting } from '@/lib/content';
import { formatDate } from '@/lib/format';
import { withBase } from '@/lib/url';

type Post = CollectionEntry<'writing'>;

export async function getStaticPaths() {
  const posts = await getWriting();
  if (posts.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { posts } },
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post } })),
  ];
}

interface Props {
  posts?: Post[];
  post?: Post;
}

const { posts, post } = Astro.props;
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
---

{
  posts && (
    <BaseLayout title="Writing" description="Notes and articles by Syeda Maliha Tabassum.">
      <PageHeader eyebrow="Writing" title="Notes and articles" />
      <section class="section">
        <ol class="wrap posts">
          {posts.map((p) => (
            <li>
              <a href={withBase(`writing/${p.id}/`)}>
                <time class="mono muted" datetime={p.data.published.toISOString()}>
                  {formatDate(p.data.published)}
                </time>
                <span class="post-title">{p.data.title}</span>
                <span class="post-desc">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    </BaseLayout>
  )
}

{
  post && Content && (
    <BaseLayout title={post.data.title} description={post.data.description} type="article">
      <article class="section">
        <div class="wrap">
          <Breadcrumbs items={[{ label: 'Writing', href: 'writing/' }]} current={post.data.title} />
          <header class="post-head">
            <time class="mono muted" datetime={post.data.published.toISOString()}>
              {formatDate(post.data.published)}
            </time>
            <h1>{post.data.title}</h1>
            <p class="lead">{post.data.description}</p>
          </header>
          <div class="prose">
            <Content />
          </div>
          <p class="back">
            <a class="arrow-link" href={withBase('writing/')}>
              <Icon name="arrow-left" /> All writing
            </a>
          </p>
        </div>
      </article>
    </BaseLayout>
  )
}

<style>
  .posts {
    list-style: none;
    display: grid;
  }

  .posts li {
    border-top: 1px solid var(--border);
  }

  .posts a {
    display: grid;
    gap: 0.3rem;
    padding-block: var(--s-3);
    text-decoration: none;
  }

  .post-title {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
  }

  .posts a:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    color: var(--text-2);
  }

  .post-head {
    display: grid;
    gap: var(--s-1);
    margin-block: var(--s-3) var(--s-6);
    max-width: var(--measure);
  }

  .post-head h1 {
    font-size: var(--step-4);
  }

  .back {
    margin-top: var(--s-6);
  }
</style>
